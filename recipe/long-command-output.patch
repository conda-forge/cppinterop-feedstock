Preserve complete command-output lines across fgets chunks. Conda's long
build prefixes make clang -print-resource-dir output exceed the 255-byte
buffer payload; treating chunks as separate lines makes DetectResourceDir
incorrectly reject its output. The enabled Interpreter_DetectResourceDir
unit test exercises this with the actual host prefix.

diff --git a/lib/CppInterOp/CppInterOp.cpp b/lib/CppInterOp/CppInterOp.cpp
--- a/lib/CppInterOp/CppInterOp.cpp
+++ b/lib/CppInterOp/CppInterOp.cpp
@@ -3572,11 +3572,17 @@
   }
 
   LLVM_DEBUG(dbgs() << "Execute returned:\n");
+  std::string line;
   while (fgets(buffer.data(), static_cast<int>(buffer.size()), pipe.get())) {
     LLVM_DEBUG(dbgs() << buffer.data());
-    llvm::StringRef trimmed = buffer.data();
-    outputs.push_back(trimmed.trim().str());
-  }
+    line += buffer.data();
+    if (!line.empty() && line.back() == '\n') {
+      outputs.push_back(llvm::StringRef(line).trim().str());
+      line.clear();
+    }
+  }
+  if (!line.empty())
+    outputs.push_back(llvm::StringRef(line).trim().str());
 
 #undef DEBUG_TYPE
 
